# ── Swiggy Instamart MCP (endpoints are public constants) ──────────────────
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_AUTH_BASE=https://mcp.swiggy.com/auth

# ── Voice → list (Google Cloud project `rasoi-prod`, NOT the OmniRoute key) ─
GEMINI_API_KEY=

# ── Owner channel (Telegram) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ── Database (Neon Postgres, aws-ap-southeast-1) ────────────────────────────
DATABASE_URL=

# ── Server secrets ──────────────────────────────────────────────────────────
# Versioned AES-256-GCM key for the Swiggy token: "v1:" + openssl rand -base64 32
TOKEN_ENC_KEY=
# Pepper for device PINs: openssl rand -hex 32
PIN_PEPPER=
# Bearer secret for /api/cron/* (Vercel sends it automatically when set)
CRON_SECRET=

# ── Order safety (Production only; adapter re-checks VERCEL_ENV) ────────────
PINNED_ADDRESS_ID=
# JSON: {"pincode":"110001","lat":28.63,"lng":77.22,"label":"Home"} (lat/lng rounded to 2 dp)
PINNED_ADDRESS_FINGERPRINT=
ALLOW_REAL_ORDERS=false

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of the deployment, e.g. https://rasoi.vercel.app (no trailing slash)
APP_URL=
